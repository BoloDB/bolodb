# ── Required ──
# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# PostgreSQL connection string (Supabase or self-hosted)
DATABASE_URL=
# Supabase project credentials (used for auth token verification)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# ── AI ──
# OpenRouter API key (https://openrouter.ai/keys)
# Used to generate SQL from natural-language questions via DeepSeek V4 Flash.
OPENROUTER_API_KEY=

# ── Email (optional) ──
# Email verification at signup (https://client.myemailverifier.com/)
MYEMAILVERIFIER_API_KEY=
# Transactional emails — verification links, password resets (https://resend.com/api-keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@bolodb.dev
# Frontend URL for building email reset/verification links
FRONTEND_URL=

# ── Analytics (optional) ──
# PostHog anonymous product analytics (respects Do Not Track)
PUBLIC_POSTHOG_PROJECT_TOKEN=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Connection encryption (required for storing DB URLs at rest) ──
# Encrypts saved connection URLs. REQUIRED — the app will not start without it,
# and saved connections cannot be stored or reopened until it is set. It is read
# only from the environment (never written to disk), so keep it stable across
# deploys: change it and previously saved connections must be re-added.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
RECENT_CONNECTIONS_KEY=

# ── Server (advanced) ──
# Session cookies carry the Secure flag (sent over HTTPS only). Defaults to
# true. Set to "false" ONLY for a deployment genuinely served over plain
# HTTP -- doing so puts session cookies on the wire in clear.
# Note: browsers treat http://localhost as a trustworthy origin and accept
# Secure cookies from it, so local development needs no change here.
COOKIE_SECURE=true
# Skip Alembic advisory lock on startup (useful for multiple replicas)
SKIP_DB_LOCK=false
# Comma-separated allowed CORS origins (default: http://localhost:5173,http://localhost)
# CORS_ORIGINS=
# Set automatically in Docker; controls SQLite path selection
# RUNNING_IN_DOCKER=true

# ── Database connection policy ──
# Whether users may connect BoloDB to databases on private/internal addresses
# (10.x, 192.168.x, 172.16–31.x, and hostnames that resolve to them). Off by
# default: on a shared deployment, a connection URL is user input, and allowing
# private targets turns it into a way to reach whatever else is on the network.
# Turn it on for a self-hosted install whose database really is on your LAN.
# Loopback, link-local and cloud metadata endpoints stay blocked either way.
ALLOW_PRIVATE_DB_HOSTS=false

# ── Database connection pool (advanced) ──
# All optional; the defaults shown are what the app uses when these are unset.
# DB_POOL_PRE_PING adds a liveness round trip to the database before handing
# out every pooled connection. It is off by default because that cost lands on
# every request and pool recycling (DB_POOL_RECYCLE below) already retires idle
# connections. Turn it on if you see "connection was closed" errors from a proxy
# that drops idle links, or if you transaction-pool through pgbouncer with a
# server_idle_timeout under DB_POOL_RECYCLE — recycling alone then leaves a gap
# in which a connection can die while idle.
DB_POOL_PRE_PING=false
# Seconds before a pooled connection is retired and reopened. Keep below the
# idle timeout of your server or connection pooler.
DB_POOL_RECYCLE=300
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ── Maintenance & Storage ──
ACTIVITY_LOG_RETENTION_DAYS=30
ACTIVITY_CLEANUP_ENABLED=true
ACTIVITY_CLEANUP_INTERVAL_HOURS=24
BOLODB_DATA_DIR=

# ── Scheduled queries ──
# Runs saved SQL on a cron schedule and emails the results. Needs RESEND_API_KEY
# above to actually deliver; without it runs are recorded and the send is
# skipped. Like the activity cleanup job this runs in-process, which is safe
# because BoloDB is deployed single-process — set it to false if the job ever
# moves to a dedicated worker.
SCHEDULED_QUERIES_ENABLED=true
# How often to look for due schedules. Cron resolves to the minute, so polling
# faster than 60s buys nothing.
SCHEDULER_TICK_SECONDS=60
# A report query gets longer than an interactive one, but not unbounded.
SCHEDULE_QUERY_TIMEOUT_SECONDS=300
# Scheduled reports run against databases that are also serving live traffic.
SCHEDULE_MAX_CONCURRENT=4
# Consecutive failures before a schedule pauses itself and emails its recipients.
SCHEDULE_MAX_FAILURES=5
# How late a run may still fire after its slot. Past this the occurrence is
# recorded as skipped, so a restart after an outage doesn't deliver yesterday's
# 9am report in the afternoon.
SCHEDULE_MISFIRE_GRACE_SECONDS=3600

# ── Slack integration (optional) ──
# Create a Slack app at https://api.slack.com/apps. Under "OAuth & Permissions"
# add the redirect URL below (must match SLACK_REDIRECT_URI exactly) and the bot
# scopes commands,chat:write,app_mentions:read. The client id/secret live under
# "Basic Information" → App Credentials.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Backend callback URL registered in the Slack app. For local dev, expose the
# backend with an https tunnel (ngrok/cloudflared) and use that URL here.
SLACK_REDIRECT_URI=http://localhost:8000/api/slack/oauth/callback
# Slack signing secret for verifying inbound events requests (Slack app config →
# Basic Information → App Credentials → Signing Secret).
SLACK_SIGNING_SECRET=
