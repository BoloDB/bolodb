# ──────────────────────────────────────────────
#  BoloDB  ·  Backend
#  Python 3.13 / FastAPI served via Uvicorn
# ──────────────────────────────────────────────
#  Build context: project root
#  docker build -f backend/DOCKERFILE -t bolodb-backend .
# ──────────────────────────────────────────────
FROM python:3.13-slim AS base

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# ── 1. Install Python dependencies (cached layer) ──
# The Snowflake / Databricks / BigQuery drivers are opt-in: they pull pandas,
# numpy, pyarrow, boto3 and grpcio between them, several hundred megabytes that
# a deployment connecting to Postgres has no use for. Build with
#   --build-arg INSTALL_WAREHOUSE_DRIVERS=true
# to include them; without them those dialects report the missing driver by name.
ARG INSTALL_WAREHOUSE_DRIVERS=false
COPY backend/requirements.txt /app/backend/requirements.txt
COPY backend/requirements-warehouses.txt /app/backend/requirements-warehouses.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt \
    && if [ "$INSTALL_WAREHOUSE_DRIVERS" = "true" ]; then \
         pip install --no-cache-dir -r /app/backend/requirements-warehouses.txt; \
       fi

# ── 2. Copy application source ──
COPY backend/        /app/backend/

# ── 3. Create non-root user ──
# /app/data holds the regenerable sample database; create it owned by the
# runtime user so it is writable whether or not a volume is mounted over it.
RUN addgroup --system bolodb && adduser --system --home /home/bolodb --ingroup bolodb bolodb \
    && mkdir -p /app/data \
    && chmod +x /app/backend/docker-entrypoint.sh \
    && chown -R bolodb:bolodb /app

USER bolodb

EXPOSE 4321

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD python -c "import httpx; httpx.get('http://localhost:4321/api/health', timeout=3).raise_for_status()" || exit 1

# Migrations run first, so a deploy pointed at a new or stale database brings
# the schema to head before the app serves its first request.
ENTRYPOINT ["/app/backend/docker-entrypoint.sh"]

# Bind every address family. "0.0.0.0" is IPv4-only, but the compose network
# runs with enable_ipv6, so DNS for `backend` answers with both an A and an
# AAAA record. nginx uses both, and the AAAA half of its requests hit
# ECONNREFUSED because nothing listens there -- "upstream server temporarily
# disabled" in the error log, and a wasted connection attempt on the way to
# the IPv4 fallback.
#
# The empty host is deliberate and "::" is *not* a substitute: asyncio sets
# IPV6_V6ONLY on any AF_INET6 server socket, so binding "::" listens on IPv6
# **only** and refuses IPv4 -- trading one broken family for the other. An
# empty host makes asyncio open one socket per family, which is real
# dual-stack. Verified in-container: 0.0.0.0 -> IPv4 only, :: -> IPv6 only,
# "" -> both.
CMD ["python", "-m", "uvicorn", "backend.app.server:create_app", \
     "--factory", "--host", "", "--port", "4321", "--log-level", "warning"]
